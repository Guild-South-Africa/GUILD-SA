AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_MAILING_LIST_TABLE=Mailing List

# Preferred signed-upload format:
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# Alternative to CLOUDINARY_URL:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional upload settings.
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_UPLOAD_FOLDER=guild-sa/join
MAX_UPLOAD_BYTES=5242880

# Mailing list welcome emails + team invite emails (Resend)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=GUILD SA <onboarding@resend.dev>
RESEND_REPLY_TO=guildsagroup@gmail.com
